extends layout

block content
  h1= title
  p Welcome to #{title}
  ol
  each val in todos
    li
      span= val.task + ' - '
      if val.completed > 0
        span.completed Completed
      else
        span.incomplete Not Completed
      form(method='POST' action='/delete')
        input(type='hidden', name='id', value=val.id)
        button(type='submit') Delete
      form(method='POST' action='/complete')
        input(type='hidden', name='id', value=val.id)
        button(type='submit') Swap Completed
      form(method='POST' action='/edit')
        input(type='hidden', name='id', value=val.id)

        label(for=`task-${val.id}`) Edit task:
        input(type='text', id=`task-${val.id}`, name='task', required)

        button(type='submit') Submit edit
      

  hr
  h2 Add a new task
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task', required)
    button(type='submit') Create Task
